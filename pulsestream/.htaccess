# PULSESTREAM — Apache tuning for long (4h+) media transfers
<IfModule mod_php.c>
  php_value max_execution_time 0
  php_value memory_limit 512M
  php_flag output_buffering Off
  php_flag zlib.output_compression Off
</IfModule>

# Never buffer/compress the streaming endpoint
<FilesMatch "download\.php$">
  SetEnv no-gzip 1
  SetEnv dont-vary 1
</FilesMatch>

# Protect internals
<FilesMatch "^(config\.php)$">
  Require all denied
</FilesMatch>

Options -Indexes
